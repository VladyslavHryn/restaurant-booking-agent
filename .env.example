# Copy to .env and fill in. Never commit .env.
TG_API_ID=
TG_API_HASH=
TG_SESSION=agent_session
# Who the agent writes to (the manager, or a second account when testing)
MANAGER_USERNAME=

# Free key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

RESTAURANT_NAME=
BOOKING_NAME=
# Optional. If empty the agent says it has no number to share (it never invents one).
BOOKING_PHONE=
PARTY_SIZE=2
BOOKING_TIME=17:00

# How much the agent may move the time on its own (minutes either side). 0 = ask the operator.
TIME_FLEX_MINUTES=60
# What the agent may say about the guest if asked. Empty = it will ask the operator.
GUEST_NOTES=
# How long the agent waits for your answer in the console before saying it doesn't know.
OPERATOR_TIMEOUT_SECONDS=90

# Voice (optional task). mirror = reply by voice once the manager sends a voice note; always; off.
VOICE_REPLIES=mirror
VOICE_CAPTION=false
TTS_VOICE=en-GB-RyanNeural
